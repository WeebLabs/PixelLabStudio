# godot-cpp is reused from addons/psd-native locally, and cloned fresh by CI into
# this folder. Never commit it.
godot-cpp/

# softcam is cloned by CI (and locally, for Windows builds) into this folder.
softcam/

# SCons build intermediates.
*.os
*.obj
*.o
*.lib
*.exp
*.pdb
.sconsign.dblite

# The built libraries ARE committed (mirrors psd-native): bin/macos/<dylib> +
# bin/windows/<dll> (the CI-built DLL). Only the MSVC sidecar files above are ignored.
